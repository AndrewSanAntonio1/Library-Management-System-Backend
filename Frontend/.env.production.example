# Production Environment Variables for Vercel

# Backend API URL
# Option 1: Using ngrok (for testing with local backend)
# VITE_API_URL=https://your-ngrok-id.ngrok.io/api

# Option 2: Using deployed backend (Railway, Render, etc.)
# VITE_API_URL=https://your-backend.railway.app/api

# Option 3: Using cloud backend
# VITE_API_URL=https://api.yourdomain.com/api

VITE_API_URL=http://localhost:8081/api

# App Configuration
VITE_APP_NAME=Library Management System
VITE_APP_VERSION=1.0.0
